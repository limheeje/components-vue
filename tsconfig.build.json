{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "composite": false,
    "incremental": false
  },
  "include": ["src/components/**/*", "src/lib/**/*", "src/scss-modules.d.ts"],
  "exclude": ["src/**/__tests__/*", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "src/demo/**/*"]
}
